# ==============================================================================
# ELDERMED FRONTEND PRODUCTION & STAGING CONFIGURATION
# Copy this file to .env or .env.production when deploying to production.
# Note: Variables prefixed with VITE_ are embedded into the client bundle at build time.
# NEVER include private API keys or database secrets in this file!
# ==============================================================================

# Backend API Base URL (leave empty if frontend & backend share reverse proxy domain e.g. /api/v1)
# For decoupled architectures (e.g. Frontend on Vercel/Netlify, Backend on api.eldermed.org):
# VITE_API_URL=https://api.eldermed.org
VITE_API_URL=
