# ==============================================================================
# ELDERMED FULL-STACK PRODUCTION CONFIGURATION TEMPLATE
# Copy to .env for Docker Compose or unified deployments.
# ==============================================================================

# Backend API Configuration
ENVIRONMENT=production
DEBUG=false
DATABASE_URL=postgresql+psycopg://postgres:postgres_secure_password@db:5432/medreminder_db
SECRET_KEY=generate_a_64_character_hex_secret_key_here
FRONTEND_URL=https://app.eldermed.org
CORS_ORIGINS=https://app.eldermed.org,http://localhost:3000

# Scheduler & Database
RUN_SCHEDULER_IN_APP=true
SEED_DEMO_DATA=false
ADMIN_INITIAL_EMAIL=admin@eldermed.org
ADMIN_INITIAL_PASSWORD=YourSecureInitialAdminPassword123!
APP_TIMEZONE=Asia/Kolkata
GRACE_PERIOD_MINUTES=30
REMINDER_CHECK_INTERVAL_SECONDS=15

# Email (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=notifications@eldermed.org

# Frontend Build (Vite)
# Leave empty if backend is reverse-proxied at /api/v1
VITE_API_URL=
