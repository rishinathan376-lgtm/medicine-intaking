# ==============================================================================
# ELDERMED BACKEND PRODUCTION & STAGING ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure all secrets before deploying to production.
# NEVER commit the real .env file or production credentials to source control!
# ==============================================================================

# Application Environment ('production', 'staging', or 'development')
ENVIRONMENT=production
DEBUG=false

# Database Connection (Production PostgreSQL recommended via psycopg3 driver)
# Standard PostgreSQL URLs from AWS RDS, Supabase, Neon, Railway, Render are auto-normalized:
# Format: postgresql+psycopg://<username>:<password>@<db-host>:<port>/<db-name>
# Development fallback: sqlite:///./medreminder.db
DATABASE_URL=postgresql+psycopg://postgres:your_secure_db_password@localhost:5432/medreminder_db

# Security & Authentication (JWT HS256)
# Generate a secure 64-char key using: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_generated_64_character_hex_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend URL & Allowed CORS Origins (comma-separated URLs; DO NOT use wildcard '*' in production)
FRONTEND_URL=https://app.eldermed.org
CORS_ORIGINS=https://app.eldermed.org,https://portal.eldermed.org,http://localhost:3000

# Rate Limiting & Abuse Protection
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=60
API_RATE_LIMIT_PER_MINUTE=300

# Medication Reminder Engine Settings
# Grace period in minutes after scheduled time before dose is marked missed & alerts caregiver
GRACE_PERIOD_MINUTES=30
APP_TIMEZONE=Asia/Kolkata
REMINDER_CHECK_INTERVAL_SECONDS=15

# Background Reminder Worker Architecture
# Set to 'true' for single-instance app deployments (scheduler runs inside FastAPI lifespan).
# Set to 'false' if running a dedicated background worker container/process via 'python -m app.worker'.
RUN_SCHEDULER_IN_APP=true

# Database Seeding Control
# Set to 'false' in production so no mock/demo patients or medicines are inserted into PostgreSQL.
# In production, only the System Administrator account is ensured if empty.
SEED_DEMO_DATA=false
ADMIN_INITIAL_EMAIL=admin@eldermed.org
ADMIN_INITIAL_PASSWORD=YourSecureInitialAdminPassword123!

# Caregiver & Patient Email Alert Settings (SMTP / SendGrid / AWS SES / Gmail)
EMAIL_ENABLED=false
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your_secure_smtp_password_or_api_key
SMTP_FROM_EMAIL=notifications@eldermed.org
